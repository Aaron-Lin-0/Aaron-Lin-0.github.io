# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore files created by npm
node_modules
package-lock.json

# Ignore the vendor file at root level and bundle for alternative installation
/vendor/
.bundle/

# Ignore folders related to IDEs
.vscode/

# Ignore files created by MacOS
.DS_Store

# Keep credentials and local configuration out of the public repository
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx

# Keep resume source and LaTeX build artifacts private
resume-source/
*.tex
*.aux
*.log
*.out
*.synctex.gz

# Local portfolio verification artifacts
tmp/
.jekyll-cache/
.impeccable/
