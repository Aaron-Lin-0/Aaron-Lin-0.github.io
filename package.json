{
  "name": "aaron-lin-engineering-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Build scripts for Aaron Lin's Jekyll engineering portfolio",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aaron-Lin-0/Aaron-Lin-0.github.io.git"
  },
  "keywords": [
    "jekyll",
    "theme",
    "minimal"
  ],
  "author": "Aaron Lin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Aaron-Lin-0/Aaron-Lin-0.github.io/issues"
  },
  "homepage": "https://aaronlin.space",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "jquery": "^4.0.0",
    "plotly.js-dist-min": "^4.1.0"
  },
  "devDependencies": {
    "jslint": "^0.12.1",
    "onchange": "^7.1.0",
    "uglify-js": "^3.19.3"    
  },
  "scripts": {
    "uglify": "uglifyjs node_modules/jquery/dist/jquery.min.js assets/js/plugins/jquery.greedy-navigation.js assets/js/_main.js assets/js/theme.js -c -m -o assets/js/main.min.js",
    "watch:js": "onchange \"assets/js/**/*.js\" -e \"assets/js/main.min.js\" -- npm run build:js",
    "build:js": "npm run uglify"
  }
}
