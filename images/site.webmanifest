---
layout: none
permalink: /images/site.webmanifest
---
{
  "name": {{ site.title | jsonify }},
  "short_name": {{ site.name | jsonify }},
  "description": {{ site.description | jsonify }},
  "start_url": "{{ site.baseurl | default: '/' }}",
  "display": "standalone",
  "background_color": "#F4F1EA",
  "theme_color": "#2F5C8A",
  "icons": [
    {
      "src": "{{ '/images/android-chrome-192x192.png' | relative_url }}",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "{{ '/images/android-chrome-512x512.png' | relative_url }}",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
